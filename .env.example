# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ─── Backend secrets (server-side only — no VITE_ prefix) ───
RESEND_API_KEY=your_resend_api_key
DATABASE_URL=your_neon_postgres_connection_string

# ─── EmailJS (public keys — bundled into frontend JS) ───
# Get these from: https://dashboard.emailjs.com
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx

# Google AdSense: no env var needed — the loader script and publisher ID
# are hardcoded directly in index.html (see comment there for why), and
# the matching pub- ID lives in /public/ads.txt.
