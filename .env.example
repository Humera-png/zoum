# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ─── Backend secrets (server-side only — no VITE_ prefix) ───
RESEND_API_KEY=your_resend_api_key
DATABASE_URL=your_neon_postgres_connection_string

# ─── EmailJS (public keys — bundled into frontend JS) ───
# Get these from: https://dashboard.emailjs.com
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx

# ─── Google AdSense (public publisher ID, not a secret) ───
# Set after your AdSense account is approved: Account > Account information.
# Looks like ca-pub-1234567890123456. Leave blank/unset to load no AdSense
# script at all. Also update /public/ads.txt with the real pub- ID once known.
VITE_ADSENSE_CLIENT_ID=
