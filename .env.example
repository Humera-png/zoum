# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ─── Frontend (public, bundled into client JS) ───
# URL of the deployed contact-form Worker (see worker/README.md). The Worker
# itself holds RESEND_API_KEY as a secret — never put it here.
VITE_CONTACT_API_URL=https://zoum-contact-api.your-subdomain.workers.dev
