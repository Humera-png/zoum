{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zoum-contact-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",

  // Plain (non-secret) config — safe to commit. RESEND_API_KEY is NOT here;
  // it's set via `wrangler secret put RESEND_API_KEY` (see README.md).
  "vars": {
    "ALLOWED_ORIGINS": "https://zoumconsultancy.com,https://www.zoumconsultancy.com,http://localhost:5173,http://localhost:4173",
    "CONTACT_TO_EMAIL": "contact@zoumconsultancy.com",
    "CONTACT_FROM_EMAIL": "ZOUM Consultancy <inquiries@zoumconsultancy.com>"
  },

  // Fixed-window rate-limit counter (per IP). Create with:
  //   npx wrangler kv namespace create RATE_LIMIT_KV
  //   npx wrangler kv namespace create RATE_LIMIT_KV --preview
  // then replace the ids below with the ones it prints.
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID",
      "preview_id": "REPLACE_WITH_KV_PREVIEW_NAMESPACE_ID"
    }
  ],

  "observability": { "enabled": true }
}
